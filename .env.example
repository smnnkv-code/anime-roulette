# MyAnimeList API credentials
# Получить на: https://myanimelist.net/apiconfig
# Client Secret НЕ нужен — только Client ID для чтения публичных списков
MAL_CLIENT_ID=your_mal_client_id_here

# Опционально: персональный Kodik API токен (при отсутствии используются резервные токены)
# KODIK_TOKEN=your_kodik_token_here

# Опционально: базовый домен Shikimori (по умолчанию https://shikimori.io)
# VITE_SHIKIMORI_DOMAIN=https://shikimori.io
# SHIKIMORI_DOMAIN=https://shikimori.io

# Мониторинг ошибок Sentry (production/preview)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_for_sourcemaps

